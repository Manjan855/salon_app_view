<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Salon App View</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>salon_app_view</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Supabase PKCE/OAuth return link: the browser is bounced back to
	     salonappview://auth-callback?code=... and iOS re-opens the app with
	     it, where supabase_flutter's deep-link observer exchanges the code
	     for the session. Must match AppEnv.authRedirectUrl and the
	     intent-filter in android/app/src/main/AndroidManifest.xml. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>supabase.auth.redirect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>salonappview</string>
			</array>
		</dict>
		<!-- Google Sign-In (iOS). Uncomment this dict and replace the placeholder
		     with the REVERSED_CLIENT_ID of your iOS OAuth client — that is the
		     part of the client ID before ".apps.googleusercontent.com", prefixed
		     with "com.googleusercontent.apps.". Required on iOS even when the
		     client ID is passed in Dart. See docs/google_signin.md.
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID</string>
			</array>
		</dict>
		-->
	</array>
	<!-- Google Sign-In client IDs (iOS). Uncomment and replace both values; keep
	     them identical to GOOGLE_IOS_CLIENT_ID / GOOGLE_SERVER_CLIENT_ID in
	     config/supabase.json. See docs/google_signin.md.
	<key>GIDClientID</key>
	<string>REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com</string>
	<key>GIDServerClientID</key>
	<string>REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com</string>
	-->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
